# Edge Function secrets.
#   Local:  supabase functions serve --env-file supabase/functions/.env
#   Hosted: supabase secrets set KEY=value

# Generate with: node app/scripts/gen-receipt-key.mjs
FIDE_RECEIPT_PRIVATE_KEY=

# Comma-separated browser origins allowed to call the functions (portal, kiosk page).
FIDE_ALLOWED_ORIGINS=http://localhost:5173

# Public site origin (https://fide-work.it in production): it serves /invite/* and
# the app-link association files. Invitation links are <FIDE_SITE_URL>/invite/<token>.
FIDE_SITE_URL=http://localhost:5174

# Optional: e-mail invitations through Brevo (EU).
FIDE_MAIL_FROM=no-reply@example.eu
BREVO_API_KEY=
