{
  "name": "fide",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace apps/mobile run start",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "npm --workspaces --if-present run lint",
    "test": "vitest run",
    "audit": "node scripts/audit.mjs",
    "sync-shared": "node scripts/sync-shared.mjs",
    "gen:caddy": "node scripts/gen-caddyfile.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.4",
    "deno": "^2.9.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  }
}
